generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  EDITOR
  VIEWER
}

enum EntryType {
  INCOME
  EXPENSE
  TRANSFER_IN
  TRANSFER_OUT
}

enum EntryStatus {
  SCHEDULED
  POSTED
  VOID
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  auditLogs    AuditLog[]
  consolidationGroups ConsolidationGroup[]
}

model Profile {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  createdAt   DateTime     @default(now())
  memberships Membership[]
  accounts    Account[]
  entries     Entry[]
  categories  Category[]
  creditCards CreditCard[]
  goals       FinancialGoal[]
  budgets     Budget[]
  commitments Commitment[]
  benefitWallets BenefitWallet[]
  incomeSchedules IncomeSchedule[]
}

model Membership {
  userId    String   @db.Uuid
  profileId String   @db.Uuid
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([userId, profileId])
}

model Account {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @db.Uuid
  name           String
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries        Entry[]

  @@unique([id, profileId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @db.Uuid
  name      String
  type      EntryType
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  entries   Entry[]

  @@unique([id, profileId])
}

model Entry {
  id          String      @id @default(uuid()) @db.Uuid
  profileId   String      @db.Uuid
  accountId   String      @db.Uuid
  categoryId  String?     @db.Uuid
  transferId  String?     @db.Uuid
  type        EntryType
  status      EntryStatus @default(POSTED)
  amount      Decimal     @db.Decimal(18, 2)
  description String
  occurredAt  DateTime
  reconciled  Boolean     @default(false)
  reconciledAt DateTime?
  createdAt   DateTime    @default(now())
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  account Account @relation(fields:[accountId,profileId], references:[id,profileId])
  category Category? @relation(fields:[categoryId,profileId], references:[id,profileId])

  @@index([profileId, occurredAt])
  @@index([transferId])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model ConsolidationGroup {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  name       String
  profileIds String[]
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

model CreditCard {
  id         String         @id @default(uuid()) @db.Uuid
  profileId  String         @db.Uuid
  name       String
  limit      Decimal        @db.Decimal(18, 2)
  closingDay Int
  dueDay     Int
  color      String?
  createdAt  DateTime       @default(now())
  profile    Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  invoices   Invoice[]
  purchases  CardPurchase[]

  @@unique([id, profileId])
}

model Invoice {
  id             String         @id @default(uuid()) @db.Uuid
  cardId         String         @db.Uuid
  profileId      String         @db.Uuid
  referenceMonth String
  dueDate        DateTime
  closingDate    DateTime
  totalAmount    Decimal        @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(18, 2)
  status         InvoiceStatus  @default(OPEN)
  createdAt      DateTime       @default(now())
  card           CreditCard     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  purchases      CardPurchase[]

  @@unique([cardId, referenceMonth])
  @@index([profileId, status])
}

model CardPurchase {
  id                String      @id @default(uuid()) @db.Uuid
  cardId            String      @db.Uuid
  profileId         String      @db.Uuid
  invoiceId         String?     @db.Uuid
  description       String
  amount            Decimal     @db.Decimal(18, 2)
  totalAmount       Decimal     @db.Decimal(18, 2)
  installmentNumber Int         @default(1)
  totalInstallments Int         @default(1)
  purchaseDate      DateTime
  categoryId        String?     @db.Uuid
  createdAt         DateTime    @default(now())
  card              CreditCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([cardId, invoiceId])
  @@index([profileId, purchaseDate])
}

enum GoalStatus {
  IN_PROGRESS
  COMPLETED
  PAUSED
}

model FinancialGoal {
  id            String     @id @default(uuid()) @db.Uuid
  profileId     String     @db.Uuid
  name          String
  targetAmount  Decimal    @db.Decimal(18, 2)
  currentAmount Decimal    @default(0) @db.Decimal(18, 2)
  targetDate    DateTime?
  status        GoalStatus @default(IN_PROGRESS)
  color         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  profile       Profile    @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model Budget {
  id             String   @id @default(uuid()) @db.Uuid
  profileId      String   @db.Uuid
  referenceMonth String
  categoryName   String
  plannedAmount  Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  profile        Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, referenceMonth, categoryName])
}

enum CommitmentType {
  PAYABLE
  RECEIVABLE
}

enum CommitmentStatus {
  PENDING
  PAID
  CANCELLED
}

model Commitment {
  id          String           @id @default(uuid()) @db.Uuid
  profileId   String           @db.Uuid
  type        CommitmentType
  status      CommitmentStatus @default(PENDING)
  description String
  amount      Decimal          @db.Decimal(18, 2)
  dueDate     DateTime
  entityName  String?
  category    String?
  accountId   String?          @db.Uuid
  isRecurring Boolean          @default(false)
  period      String?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime         @default(now())
  profile     Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, dueDate])
  @@index([profileId, status])
}

// Versão 2.7: contas de benefícios não se misturam ao saldo bancário.
enum BenefitKind {
  MARKET
  FUEL
  OTHER
}

enum BenefitMovementType {
  RECHARGE
  PURCHASE
  ADJUSTMENT
}

model BenefitWallet {
  id             String            @id @default(uuid()) @db.Uuid
  profileId      String            @db.Uuid
  name           String
  kind           BenefitKind
  openingBalance Decimal           @default(0) @db.Decimal(18, 2)
  createdAt      DateTime          @default(now())
  profile        Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  movements      BenefitMovement[]

  @@index([profileId])
}

model BenefitMovement {
  id             String              @id @default(uuid()) @db.Uuid
  walletId       String              @db.Uuid
  type           BenefitMovementType
  amount         Decimal             @db.Decimal(18, 2)
  description    String
  occurredAt     DateTime
  // Recargas automáticas mensais usam chave determinística para evitar repetição.
  referenceMonth String?
  createdAt      DateTime            @default(now())
  wallet         BenefitWallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId,referenceMonth])
  @@index([walletId, occurredAt])
}

model IncomeSchedule {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  name        String
  amount      Decimal  @db.Decimal(18, 2)
  dayOfMonth  Int
  accountId   String   @db.Uuid
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}
