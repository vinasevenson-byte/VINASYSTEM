{
  "name": "vina-finace",
  "version": "1.3.0",
  "private": true,
  "description": "VINA FINACE — ERP de Gestão Financeira Pessoal e Familiar",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/invariants.test.cjs",
    "test:invariants": "node --test tests/invariants.test.cjs",
    "dev:web": "npm run dev --workspace=@boma/web",
    "dev:api": "npm run dev --workspace=@boma/api",
    "dev": "npm run dev:web",
    "build:web": "npm run build --workspace=@boma/web",
    "build:api": "npm run build --workspace=@boma/api",
    "build": "npm run build:web",
    "db:start": "node scripts/db.cjs",
    "db:generate": "npm run --workspace=@boma/api db:generate",
    "db:push": "npm run --workspace=@boma/api db:push",
    "db:migrate": "npm run --workspace=@boma/api db:migrate"
  },
  "keywords": [
    "finance",
    "personal-finance",
    "multi-profile",
    "dashboard",
    "banking"
  ],
  "author": "BOMA Finance Team",
  "license": "MIT",
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true,
    "@nestjs/core@10.4.22": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
