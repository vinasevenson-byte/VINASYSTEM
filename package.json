{
  "name": "boma-finance",
  "version": "1.1.0",
  "private": true,
  "description": "BOMA Finance — Gestão Financeira Pessoal, Familiar e Multiperfis (v1.1)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "test": "node --test tests/invariants.test.cjs",
    "test:invariants": "node --test tests/invariants.test.cjs",
    "dev:web": "npm run dev --workspace=@boma/web",
    "dev:api": "npm run dev --workspace=@boma/api",
    "dev": "npm run dev:web",
    "build:web": "npm run build --workspace=@boma/web",
    "build:api": "npm run build --workspace=@boma/api",
    "build": "npm run build:web",
    "db:generate": "npx prisma generate --schema=apps/api/prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=apps/api/prisma/schema.prisma"
  },
  "keywords": [
    "finance",
    "personal-finance",
    "multi-profile",
    "dashboard",
    "banking"
  ],
  "author": "BOMA Finance Team",
  "license": "MIT"
}
